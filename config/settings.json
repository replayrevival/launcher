  "ignore_for_preset": ["enhance.overlay_guide", "audio.master_volume", "window.hide_cursor", "video.width", "video.height", "video.mode", "video.display", "enhance.button_prompts",
                        "video.hd_art", "video.hd_art_sky", "video.hd_art_ground", "video.hd_art_roofs", "video.hd_art_billboards"],
  "forced": {"video.menu_aspect": "pillar"},
  "migrate": {"video.aspect": {"stretch": "wide"}},

  "presets": [
    {"id": "original", "name": "ORIGINAL",
     "description": "Exactly how it looked on the console: original aspect, original draw distance, nothing extra.",
     "values": {"video.vsync": "on"}},
    {"id": "max", "name": "MAX",
     "description": "Widescreen, full resolution, unlimited draw distance, 16x filtering, and everything unlocked.",
     "values": {
       "video.aspect": "wide", "video.fps_cap": "60", "video.vsync": "on", "video.render_ahead": "1",
       "video.draw_distance": "unlimited", "video.fog_scale": "4", "video.fov_scale": "1", "video.fov_min_zoom": "0.7854",
       "video.cull_margin": "1", "video.anisotropy": "16", "video.mip_bias": "0",
       "enhance.unlock_all_monsters": "1", "enhance.unlock_all_cities": "1", "enhance.unlock_all_challenges": "1"}},
    {"id": "low", "name": "LOW-END",
     "description": "1080p output rendered at 720p and sharpened with FSR 1.0, for older PCs and handhelds.",
     "values": {
       "video.aspect": "wide", "video.fps_cap": "60", "video.vsync": "on",
       "video.render_ahead": "1", "video.render_scale": "0.667", "video.upscale": "fsr1", "video.fsr_sharpness": "0.25",
       "video.draw_distance": "2", "video.fog_scale": "1", "video.fov_scale": "1", "video.cull_margin": "1",
       "video.anisotropy": "0", "video.mip_bias": "0", "video.render_threads": "2"}}
  ],

  "env_by_preset": {
    "max": {"STE_KELVIN_CULL": "2"},
    "low": {"STE_KELVIN_CULL": "2", "STE_TEXPACKS": "0"}
  },

  "pages": {
    "controls": [
      {"id": "prompts", "apply": "match", "label": "Button prompts", "hint": "Which button names the game and this launcher show.",
       "choices": [
         {"label": "Auto (match my controller)", "set": {"enhance.button_prompts": "auto"}},
         {"label": "Xbox", "set": {"enhance.button_prompts": "xbox"}},
         {"label": "Original Xbox (Black and White)", "set": {"enhance.button_prompts": "xbox_original"}},
         {"label": "PlayStation", "set": {"enhance.button_prompts": "playstation"}}]},
      {"id": "guide", "apply": "restart", "type": "toggle", "label": "Guide button opens the menu", "hint": "The Guide / Home / PlayStation button also opens the in-game menu. Off by default; holding Back and Start, or F1, always work.", "on": {"enhance.overlay_guide": "1"}}
    ],
    "video": [
      {"id": "display", "type": "display", "label": "Display", "hint": "Which monitor the game opens on"},
      {"id": "res", "type": "resolution", "label": "Resolution", "hint": "Native is your screen's own resolution"},
      {"id": "mode", "label": "Window", "hint": "Borderless works best with variable refresh rate",
       "choices": [
         {"label": "Window", "set": {"video.mode": "window"}},
         {"label": "Borderless", "set": {"video.mode": "borderless"}},
         {"label": "Fullscreen", "set": {"video.mode": "fullscreen"}}]},
      {"id": "aspect", "apply": "restart", "label": "Gameplay view", "hint": "Fit my screen shows more of the world. Menus always keep their original 4:3 shape",
       "choices": [
         {"label": "Original (4:3)", "set": {"video.aspect": "4:3-pillar"}},
         {"label": "Fit my screen", "set": {"video.aspect": "wide"}}]},
      {"id": "scale", "label": "Render scale", "hint": "Lower is faster, upscaled with FSR 1.0",
       "choices": [
         {"label": "100%", "set": {"video.render_scale": null, "video.upscale": null}},
         {"label": "85%", "set": {"video.render_scale": "0.85", "video.upscale": "fsr1"}},
         {"label": "75%", "set": {"video.render_scale": "0.75", "video.upscale": "fsr1"}},
         {"label": "67%", "set": {"video.render_scale": "0.667", "video.upscale": "fsr1"}},
         {"label": "50%", "set": {"video.render_scale": "0.5", "video.upscale": "fsr1"}}]},
      {"id": "fps", "apply": "restart", "label": "Frame rate", "hint": "The game keeps its original speed at any setting",
       "choices": [
         {"label": "60", "set": {"video.fps_cap": "60"}},
         {"label": "30", "set": {"video.fps_cap": "30"}},
         {"label": "Uncapped", "set": {"video.fps_cap": "0"}}]},
      {"id": "vsync", "apply": "restart", "type": "toggle", "label": "V-Sync", "hint": "On = no tearing (recommended). Off = lowest latency, may tear.",
       "on": {"video.vsync": "on"}},
      {"id": "vrr", "apply": "restart", "label": "Variable refresh rate", "hint": "Needs FreeSync/G-Sync enabled on your monitor and graphics driver.",
       "choices": [
         {"label": "Auto", "set": {"video.vrr": "auto"}},
         {"label": "Off", "set": {"video.vrr": "off"}}]},
      {"id": "draw", "apply": "restart", "label": "Draw distance", "hint": "Stops distant objects from vanishing",
       "choices": [
         {"label": "Original", "set": {"video.draw_distance": "1"}},
         {"label": "2x", "set": {"video.draw_distance": "2"}},
         {"label": "4x", "set": {"video.draw_distance": "4"}},
         {"label": "Unlimited", "set": {"video.draw_distance": "unlimited"}}]},
      {"id": "fov", "apply": "restart", "label": "Field of view", "hint": "Wider shows more of the arena",
       "choices": [
         {"label": "Original", "set": {"video.fov_scale": "1"}},
         {"label": "Wider", "set": {"video.fov_scale": "1.1"}},
         {"label": "Widest", "set": {"video.fov_scale": "1.2"}}]},
      {"id": "aniso", "label": "Texture filtering", "hint": "Sharper surfaces at an angle",
       "choices": [
         {"label": "Off", "set": {"video.anisotropy": "0"}},
         {"label": "2x", "set": {"video.anisotropy": "2"}},
         {"label": "4x", "set": {"video.anisotropy": "4"}},
         {"label": "8x", "set": {"video.anisotropy": "8"}},
         {"label": "16x", "set": {"video.anisotropy": "16"}}]},
      {"group": "SOUND AND POINTER"},
      {"id": "volume", "apply": "now", "label": "Volume", "hint": "The game's overall volume.",
       "choices": [
         {"label": "100%", "set": {"audio.master_volume": "100"}},
         {"label": "90%", "set": {"audio.master_volume": "90"}},
         {"label": "80%", "set": {"audio.master_volume": "80"}},
         {"label": "70%", "set": {"audio.master_volume": "70"}},
         {"label": "60%", "set": {"audio.master_volume": "60"}},
         {"label": "50%", "set": {"audio.master_volume": "50"}},
         {"label": "40%", "set": {"audio.master_volume": "40"}},
         {"label": "30%", "set": {"audio.master_volume": "30"}},
         {"label": "20%", "set": {"audio.master_volume": "20"}},
         {"label": "10%", "set": {"audio.master_volume": "10"}},
         {"label": "0% (mute)", "set": {"audio.master_volume": "0"}}]},
      {"id": "cursor", "apply": "now", "label": "Mouse pointer", "hint": "Auto hides it after 3 seconds without movement.",
       "choices": [
         {"label": "Auto", "set": {"window.hide_cursor": "auto"}},
         {"label": "Always hidden", "set": {"window.hide_cursor": "always"}},
         {"label": "Always shown", "set": {"window.hide_cursor": "never"}}]},
      {"group": "HD ART", "needs": "hd_art"},
      {"id": "hd", "needs": "hd_art", "type": "toggle", "label": "HD art", "hint": "Sharper replacement pictures, made for this game. Needs the HD art files.", "on": {"video.hd_art": "1"}},
      {"id": "hd_sky", "needs": "hd_art", "label": "Sky", "hint": "Replacement sky pictures. Only used while HD art is on.",
       "choices": [
         {"label": "On", "set": {"video.hd_art_sky": "1"}},
         {"label": "Off", "set": {"video.hd_art_sky": "0"}}]},
      {"id": "hd_ground", "needs": "hd_art", "label": "Ground", "hint": "Replacement ground pictures. Only used while HD art is on.",
       "choices": [
         {"label": "On", "set": {"video.hd_art_ground": "1"}},
         {"label": "Off", "set": {"video.hd_art_ground": "0"}}]},
      {"id": "hd_roofs", "needs": "hd_art", "label": "Roofs", "hint": "Replacement roof pictures. Only used while HD art is on.",
       "choices": [
         {"label": "On", "set": {"video.hd_art_roofs": "1"}},
         {"label": "Off", "set": {"video.hd_art_roofs": "0"}}]},
      {"id": "hd_bill", "needs": "hd_art", "label": "Billboards", "hint": "Replacement billboard pictures. Only used while HD art is on.",
       "choices": [
         {"label": "On", "set": {"video.hd_art_billboards": "1"}},
         {"label": "Off", "set": {"video.hd_art_billboards": "0"}}]}
    ],
    "enhance": [
      {"group": "UNLOCKS"},
      {"id": "u_mon", "apply": "match", "type": "toggle", "label": "Unlock all monsters", "hint": "The full 18-monster Versus grid. Not written to your save.", "on": {"enhance.unlock_all_monsters": "1"}},
      {"id": "u_city", "apply": "match", "type": "toggle", "label": "Unlock all cities", "hint": "Changes the city order. Not written to your save.", "on": {"enhance.unlock_all_cities": "1"}},
      {"id": "u_chal", "apply": "match", "type": "toggle", "label": "Unlock all challenges", "hint": "Not written to your save.", "on": {"enhance.unlock_all_challenges": "1"}},
      {"id": "u_gal", "apply": "match", "type": "toggle", "label": "Unlock the gallery", "hint": "All Gallery items.", "on": {"enhance.unlock_gallery": "1"}},
      {"id": "u_fw", "apply": "match", "type": "toggle", "label": "Unlock Final Wars items", "hint": "All Final Wars gallery items.", "on": {"enhance.unlock_final_wars": "1"}},
      {"id": "u_bio", "apply": "match", "type": "toggle", "label": "Unlock Biollante", "hint": "Needs the Biollante slot mod.", "on": {"enhance.unlock_biollante": "1"}},
      {"group": "GAMEPLAY RULES"},
      {"id": "size", "apply": "match", "label": "Monster size", "hint": "Camera and hit boxes follow the size.",
       "choices": [
         {"label": "Original", "set": {"enhance.stem_rule_player_size": "0"}},
         {"label": "150%", "set": {"enhance.stem_rule_player_size": "150"}},
         {"label": "200%", "set": {"enhance.stem_rule_player_size": "200"}},
         {"label": "300%", "set": {"enhance.stem_rule_player_size": "300"}}]},
      {"id": "shake", "apply": "match", "type": "toggle", "label": "Footstep camera shake", "hint": "Big monsters shake the screen.", "on": {"enhance.stem_footstep_camera_shake": "1"}},
      {"id": "rage", "apply": "match", "label": "Rage meter", "hint": "How the rage meter fills.",
       "choices": [
         {"label": "Original", "set": {"enhance.stem_rule_rage_meter": "0"}},
         {"label": "Damage taken", "set": {"enhance.stem_rule_rage_meter": "1"}},
         {"label": "Damage dealt", "set": {"enhance.stem_rule_rage_meter": "2"}},
         {"label": "Both", "set": {"enhance.stem_rule_rage_meter": "3"}},
         {"label": "Over time", "set": {"enhance.stem_rule_rage_meter": "4"}},
         {"label": "All", "set": {"enhance.stem_rule_rage_meter": "5"}}]},
      {"id": "veh", "apply": "match", "type": "toggle", "label": "More traffic", "hint": "Vehicles fill the city from the start.", "on": {"enhance.stem_more_ai_vehicles": "1"}},
      {"id": "jug", "apply": "match", "type": "toggle", "label": "No juggle limit", "hint": "Air combos are not capped.", "on": {"enhance.stem_no_juggle_limit": "1"}},
      {"id": "knock", "apply": "match", "type": "toggle", "label": "No knockback scaling", "hint": "", "on": {"enhance.stem_no_knockback_scaling": "1"}},
      {"id": "minhp", "apply": "match", "type": "toggle", "label": "No minimum health", "hint": "", "on": {"enhance.stem_no_min_health": "1"}},
      {"id": "wvk", "apply": "match", "type": "toggle", "label": "Weapon-independent vertical knockback", "hint": "", "on": {"enhance.stem_weapon_vertical_knockback": "1"}},
      {"id": "dim", "apply": "match", "type": "toggle", "label": "No results-screen dimming", "hint": "", "on": {"enhance.stem_no_results_dim": "1"}},
      {"id": "empty", "apply": "match", "type": "toggle", "label": "Empty arena", "hint": "Flat ground, no buildings.", "on": {"enhance.stem_rule_empty_arena": "1"}},
      {"group": "CHEATS"},
      {"id": "inv1", "apply": "match", "type": "toggle", "label": "Player 1 invulnerable", "hint": "Checked against the real game.", "on": {"enhance.cheat_invulnerable_p1": "1"}},
      {"id": "invc", "apply": "match", "type": "toggle", "label": "Computer player invulnerable", "hint": "", "on": {"enhance.cheat_invulnerable_com": "1"}},
      {"id": "sdmg", "apply": "match", "type": "toggle", "label": "Computer player super damage", "hint": "", "on": {"enhance.cheat_super_damage_com": "1"}},
      {"id": "red1", "apply": "match", "type": "toggle", "label": "Player 1 red", "hint": "", "on": {"enhance.cheat_red_p1": "1"}},
      {"id": "redc", "apply": "match", "type": "toggle", "label": "Computer player red", "hint": "", "on": {"enhance.cheat_red_com": "1"}},
      {"group": "SAVES"},
      {"id": "seed", "apply": "match", "type": "toggle", "label": "Start with the game folder's saves", "hint": "Off starts empty, like a new console.", "on": {"enhance.seed_from_game_dir": "1"}}
    ]
  }
}
