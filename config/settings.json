    "enhance.unlock_all_monsters": {"s": "enhance", "k": "unlock_all_monsters", "d": "0"},
    "enhance.unlock_all_cities": {"s": "enhance", "k": "unlock_all_cities", "d": "0"},
    "enhance.unlock_all_challenges": {"s": "enhance", "k": "unlock_all_challenges", "d": "0"},
    "enhance.unlock_gallery": {"s": "enhance", "k": "unlock_gallery", "d": "0"},
    "enhance.unlock_final_wars": {"s": "enhance", "k": "unlock_final_wars", "d": "0"},
